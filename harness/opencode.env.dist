# Environment for ~/.config/opencode/.env
#
#   cp harness/opencode.env.dist ~/.config/opencode/.env   # then fill in real values
#
# The file is sourced by direnv (~/.config/opencode/.envrc: `source .env`) and read
# by OpenCode through {env:...} interpolation in opencode.json. Names only: every
# value below is a secret or a machine-specific choice, and the filled-in .env never
# enters this repository.

# --- Provider -------------------------------------------------------------
export NAN_API_KEY=""              # {env:NAN_API_KEY}
export NAN_BASE_URL=""             # {env:NAN_BASE_URL}

# --- Per-agent model overrides --------------------------------------------
# All twelve are interpolated in opencode.json. A missing one leaves that agent
# without a model, which is why this list is the point of the template.
export OPENCODE_MODEL=""
export OPENCODE_SMALL_MODEL=""
export OPENCODE_LEAD_MODEL=""
export OPENCODE_RESEARCHER_MODEL=""
export OPENCODE_SPECIFIER_MODEL=""
export OPENCODE_DEVELOPER_MODEL=""
export OPENCODE_REVIEWER_MODEL=""
export OPENCODE_DESIGNER_MODEL=""
export OPENCODE_SCOPER_MODEL=""
export OPENCODE_EVALUATOR_MODEL=""
export OPENCODE_EVOLVER_MODEL=""
export OPENCODE_DEBUGGER_MODEL=""

# --- Optional integrations ------------------------------------------------
export OPEN_DESIGN_URL=""          # read by the kit's open-design plugin, not by opencode.json

# Not listed on purpose: the engram and orca plugins are excluded from this
# repository (see blueprints/opencode.md, "Not included"). Their ENGRAM_* and
# ORCA_AGENT_HOOK_* overrides belong to those plugins.
